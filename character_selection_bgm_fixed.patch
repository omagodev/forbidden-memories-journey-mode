+/* The character creator uses the existing game BGM driver. A dedicated
+ * "chargen" track may be set in journey.json; otherwise use the village
+ * daytime track. The sound driver handles looping. */
+static int creator_music_active;
+static void creator_music_tick(void)
+{
+    if (state == ST_LANG || state == ST_CREATE) {
+        if (!creator_music_active) {
+            int track = track_cfg("chargen");
+            if (track < 0) track = track_cfg("day");
+            if (track >= 0) {
+                SD_BGMPlay(0x7000 + (u32)track * 0x10);
+            }
+            creator_music_active = 1;
+        }
+    } else if (creator_music_active) {
+        SD_BGMFadeOut();
+        creator_music_active = 0;
+    }
+}
